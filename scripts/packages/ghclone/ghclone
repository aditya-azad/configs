#!/usr/bin/env bash
# ghclone — back up every repo for a GitHub user as zips over SSH.
#
# Lists all of <username>'s repositories with `gh` (the GitHub CLI), clones each
# one with ALL branches — a local tracking branch is created for every remote
# branch, not just the default — then zips the full clone (working tree plus
# .git, so every branch and the whole history is backed up) into
# <dest>/<repo>.zip, replacing any zip already there. The clone is staged in a
# temp dir and removed after zipping; only the zips land in <dest>. Public repos
# are always included; private repos only when <username> is the account `gh` is
# authenticated as (the SSH key can't reach anyone else's private repos anyway).
#
# `gh` must be installed and authenticated. Run `gh auth login` once — choose
# SSH when prompted and it reuses your existing ~/.ssh/id_ed25519 for git
# transport; it only needs the token to *list* repos, the SSH key does all the
# cloning.
#
#   ghclone <username> [dest]        confirm, then clone (all branches) + zip
#   ghclone -n <username> [dest]     dry-run: list repos, clone/zip nothing
#   ghclone -y <username> [dest]     skip the confirmation prompt
#   ghclone -h                        usage
#
# dest defaults to ~/database/code; each repo → <dest>/<repo>.zip (replacing).
# `gh repo list` caps at 1000 repos per owner.

set -euo pipefail
export GIT_TERMINAL_PROMPT=0

DEST_DEFAULT="$HOME/database/code"

GH="$(command -v gh || true)"
if [ -z "$GH" ]; then
  echo "ghclone: 'gh' not found. Add 'gh' to environment.systemPackages and rebuild." >&2
  exit 1
fi
ZIP="$(command -v zip || true)"
if [ -z "$ZIP" ]; then
  echo "ghclone: 'zip' not found. Add 'zip' to environment.systemPackages and rebuild." >&2
  exit 1
fi

usage() {
  cat <<EOF
ghclone — back up every repo for a GitHub user as zips over SSH

Usage:
  ghclone [-n|--dry-run] [-y|--yes] <username> [dest]

  <username>   GitHub user whose repos to back up. Public repos always; private
               repos only when this is the account \`gh\` is authenticated as.
  dest         target directory for the zips (default: ~/database/code); each
               repo → <dest>/<repo>.zip, replacing any zip already there.

  -n, --dry-run   list the repos that would be backed up, then exit
  -y, --yes       skip the confirmation prompt
  -h, --help      this help

Each repo is cloned with ALL branches (local tracking branches for every remote
branch), then the full clone (working tree + .git) is zipped into <dest>. The
clone is staged in a temp dir and removed after zipping — only the zips land in
<dest>. Cloning uses your SSH key (git@github.com:…); \`gh\` must be authenticated
(\`gh auth login\`) — it only lists the repos, the SSH key does all the git
transport.
EOF
}

DRY_RUN=0
YES=0
USERNAME=""
DEST=""

while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    -n|--dry-run) DRY_RUN=1; shift ;;
    -y|--yes) YES=1; shift ;;
    -*) echo "ghclone: unknown option '$1'" >&2; usage >&2; exit 2 ;;
    *)
      if [ -z "$USERNAME" ]; then USERNAME="$1"
      elif [ -z "$DEST" ];     then DEST="$1"
      else echo "ghclone: unexpected argument '$1'" >&2; exit 2; fi
      shift
      ;;
  esac
done

if [ -z "$USERNAME" ]; then
  echo "ghclone: <username> is required" >&2
  usage >&2
  exit 2
fi
DEST="${DEST:-$DEST_DEFAULT}"

# auth check — gh needs a token only to list; the SSH key handles the rest.
if ! "$GH" auth status >/dev/null 2>&1; then
  echo "ghclone: gh is not authenticated. Run \`gh auth login\` (choose SSH;" >&2
  echo "          it reuses your existing ~/.ssh/id_ed25519 for git)." >&2
  exit 1
fi

# Enumerate the user's repos. We build the SSH URL ourselves from nameWithOwner
# (git@github.com:<owner>/<repo>.git) so the clone goes over the configured key,
# regardless of which transport `gh` would pick. defaultBranchRef is null for an
# empty repo — we use that to skip repos with no branches.
ERR_FILE="$(mktemp)"
RAW="$("$GH" repo list "$USERNAME" --limit 1000 \
        --json name,nameWithOwner,defaultBranchRef \
        --jq '.[] | [.name, .nameWithOwner, (.defaultBranchRef.name // "")] | @tsv' \
        2>"$ERR_FILE")" || {
  echo "ghclone: \`gh repo list $USERNAME\` failed:" >&2
  sed 's/^/  /' "$ERR_FILE" >&2
  rm -f "$ERR_FILE"
  exit 1
}
rm -f "$ERR_FILE"

if [ -z "$RAW" ]; then
  echo "ghclone: no repositories found for '$USERNAME'."
  exit 0
fi

mapfile -t REPOS <<<"$RAW"
TOTAL=${#REPOS[@]}

echo "Found ${TOTAL} repo(s) for '${USERNAME}' → ${DEST}/"
if [ "$DRY_RUN" -eq 1 ]; then
  while IFS=$'\t' read -r name _owner branch; do
    [ -z "$name" ] && continue
    if [ -z "$branch" ]; then
      printf '  %-40s  (no default branch — empty repo, would skip)\n' "$name"
    else
      printf '  %-40s  all branches → %s.zip\n' "$name" "$name"
    fi
  done <<<"$RAW"
  exit 0
fi

if [ "$YES" -eq 0 ]; then
  read -r -p "Clone (all branches) + zip ${TOTAL} repo(s) into ${DEST}/? [y/N]: " ans
  case "$ans" in
    [Yy]|[Yy][Ee][Ss]) ;;
    *) echo "Cancelled."; exit 0 ;;
  esac
fi

mkdir -p "$DEST"

# Create a local tracking branch for every remote branch (not just the default).
# `git clone` fetches all remote branches as remote-tracking refs but checks out
# only the default as a local branch; this makes the rest local too so the zip
# carries every branch. The default branch already exists locally — the
# `|| true` swallows the "already exists" error for it.
clone_all_branches() {
  local dir="$1" remote
  while read -r remote; do
    [ -n "$remote" ] || continue
    [[ "$remote" == "origin/HEAD" ]] && continue
    git -C "$dir" branch --track "${remote#origin/}" "$remote" >/dev/null 2>&1 || true
  done < <(git -C "$dir" branch -r 2>/dev/null | grep -v '\->' || true)
}

zipped=0 skipped=0 failed=0
while IFS=$'\t' read -r name owner branch; do
  [ -z "$name" ] && continue

  if [ -z "$branch" ]; then
    echo "  skip    $name  (no default branch — empty repo)"
    skipped=$((skipped + 1))
    continue
  fi

  ssh_url="git@github.com:${owner}.git"
  stage="$(mktemp -d)"

  if git clone "$ssh_url" "$stage/$name" >/dev/null 2>&1; then
    clone_all_branches "$stage/$name"
    rm -f "$DEST/$name.zip"
    if (cd "$stage" && "$ZIP" -rq "$DEST/$name.zip" "$name"); then
      echo "  zip     $name  (all branches)"
      zipped=$((zipped + 1))
    else
      echo "  fail    $name  (zip failed)" >&2
      rm -f "$DEST/$name.zip"
      failed=$((failed + 1))
    fi
  else
    echo "  fail    $name  (git clone failed — see $ssh_url)" >&2
    failed=$((failed + 1))
  fi

  rm -rf "$stage"
done <<<"$RAW"

echo
echo "Done: ${zipped} zipped, ${skipped} skipped, ${failed} failed."
[ "$failed" -eq 0 ]
