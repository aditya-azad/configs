#!/usr/bin/env bash
# st — theme switcher
#
# Architecture:
#   themes/<name>/colors.conf   palette + metadata (sourceable bash)
#   templates/*.tpl             {{KEY}} templates, one per generated config
#   setters/*.sh                per-app reload scripts, sourced after swap
#
# On switch:
#   1. Source the theme's colors.conf.
#   2. Generate configs from templates into a staging dir.
#   3. Atomic swap: staging -> ~/.local/state/themes/current/.
#   4. Source each setter (inherits palette vars + STATE_DIR).
#
# Self-locates its data dir — no Nix wrapper needed.

set -euo pipefail

# ── self-locate ────────────────────────────────────────────────────────
SCRIPT_DIR="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd)"
THEME_DIR="$SCRIPT_DIR"
THEMES_DIR="$SCRIPT_DIR/themes"
TEMPLATES_DIR="$SCRIPT_DIR/templates"
SETTERS_DIR="$SCRIPT_DIR/setters"
DOTFILES_DIR="${ST_DOTFILES_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}}"

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/themes"

# ── helpers ────────────────────────────────────────────────────────────
available_themes() {
  [ -d "$THEMES_DIR" ] && ls -1 "$THEMES_DIR" || true
}

current_name() {
  if [ -f "$STATE_DIR/current.name" ]; then
    cat "$STATE_DIR/current.name"
  elif [ -f "$HOME/.config/.theme" ]; then
    # migrate from old st format (0=dark, 1=light)
    case "$(cat "$HOME/.config/.theme" 2>/dev/null)" in
      0) echo dark ;; 1) echo light ;; *) echo "" ;;
    esac
  else
    echo ""
  fi
}

toggle_target() {
  local cur; cur="$(current_name)"
  case "$cur" in
    dark)  echo light ;;
    light) echo dark ;;
    *)     echo dark ;;   # default to dark on first run
  esac
}

# Substitute {{KEY}} -> value for each KEY in colors.conf.
substitute_template() {
  local tpl_file="$1" conf_file="$2"
  local result; result="$(cat "$tpl_file")"
  while IFS= read -r line || [ -n "$line" ]; do
    [[ "$line" =~ ^[[:space:]]*# ]] && continue
    [[ -z "${line// }" ]] && continue
    local key="${line%%=*}"
    local val="${line#*=}"
    key="${key// /}"
    val="${val#\"}"; val="${val%\"}"
    val="${val# }"; val="${val% }"
    [[ "$key" =~ ^[A-Z_][A-Z0-9_]*$ ]] || continue
    result="${result//\{\{$key\}\}/$val}"
  done < "$conf_file"
  printf '%s\n' "$result"
}

# ── apply a theme ──────────────────────────────────────────────────────
apply() {
  local name="$1"
  local theme_dir="$THEMES_DIR/$name"
  if [ ! -d "$theme_dir" ]; then
    echo "Unknown theme: $name" >&2
    echo "Available: $(available_themes | tr '\n' ' ')" >&2
    return 1
  fi

  mkdir -p "$STATE_DIR"
  local next="$STATE_DIR/next"
  rm -rf "$next"
  mkdir -p "$next"

  # 1. source palette (vars available to setters later)
  # shellcheck disable=SC1090
  source "$theme_dir/colors.conf"

  # 2. generate from templates
  if [ -d "$TEMPLATES_DIR" ]; then
    for tpl in "$TEMPLATES_DIR"/*.tpl; do
      [ -f "$tpl" ] || continue
      local out_name; out_name="$(basename "$tpl" .tpl)"
      substitute_template "$tpl" "$theme_dir/colors.conf" > "$next/$out_name"
    done
  fi

  # 3. atomic swap (mv is atomic on same filesystem)
  local old="$STATE_DIR/old"
  rm -rf "$old"
  [ -d "$STATE_DIR/current" ] && mv "$STATE_DIR/current" "$old"
  mv "$next" "$STATE_DIR/current"
  rm -rf "$old"

  echo "$name" > "$STATE_DIR/current.name"

  # 4. run setters (sourced — inherit STATE_DIR, palette vars, env)
  if [ -d "$SETTERS_DIR" ]; then
    for setter in "$SETTERS_DIR"/*.sh; do
      [ -f "$setter" ] || continue
      # shellcheck disable=SC1090
      source "$setter"
    done
  fi

  echo "Theme: $name"
}

# ── CLI ────────────────────────────────────────────────────────────────
case "${1:-}" in
  list)
    available_themes
    ;;
  current)
    cur="$(current_name)"
    [ -n "$cur" ] && echo "$cur" || echo "(none — run: st)"
    ;;
  ""|toggle)
    apply "$(toggle_target)"
    ;;
  -h|--help)
    cat <<EOF
st — theme switcher

Usage:
  st              toggle dark <-> light
  st <name>       set theme by name
  st list         list available themes
  st current      show current theme

State:   $STATE_DIR/
Themes:  $THEMES_DIR/
EOF
    ;;
  *)
    apply "$1"
    ;;
esac
