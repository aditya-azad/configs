#!/usr/bin/env bash
# qvm — generic QEMU/KVM launcher.
#
# OS/VM-specific details (CPU flags, TPM, install media, disk size, GPU
# mode, install notes, ...) live in each VM's spec file:
#
#   $VM_ROOT/<vm>/<vm>.sh      (VM_ROOT defaults to ~/.vms)
#
# Adding a VM is just dropping a spec file — no change to this launcher.
# Mutable state (disk.qcow2, OVMF vars, sockets) is created in the VM's
# directory on first run.
#
#   qvm <vm>           start (auto-attach display); re-attach if running
#   qvm <vm> install   first run: create the disk + boot from VM_ISO
#   qvm <vm> kill      stop (graceful ACPI powerdown, then SIGKILL)
#   qvm -h             usage

set -euo pipefail

# Where VMs live: $VM_ROOT/<vm>/<vm>.sh + per-VM state. Override with
# QVM_VMS_DIR. home-manager deploys this script into the nix store, so do
# NOT derive VM_ROOT from realpath of $0 (that would point at the store).
VM_ROOT="${QVM_VMS_DIR:-$HOME/.vms}"

# OVMF firmware — set by NixOS (QVM_OVMF_*); fallback to the system profile.
OVMF_CODE="${QVM_OVMF_CODE:-/run/current-system/sw/share/OVMF/OVMF_CODE.fd}"
OVMF_VARS_SRC="${QVM_OVMF_VARS:-/run/current-system/sw/share/OVMF/OVMF_VARS.fd}"

die() { echo "qvm: $*" >&2; exit 1; }

# list VM names that have a <name>.sh spec in $VM_ROOT
list_vms() {
  [ -d "$VM_ROOT" ] || return 0
  local d name
  shopt -s nullglob
  for d in "$VM_ROOT"/*/; do
    name="$(basename "$d")"
    [ -f "$d${name}.sh" ] && printf '%s\n' "$name"
  done
  shopt -u nullglob
  return 0
}

usage() {
  cat <<EOF
qvm — generic qemu/kvm launcher

Usage:
  qvm <vm>           start (auto-attach display); re-attach if running
  qvm <vm> install   first run: create disk + boot from VM_ISO
  qvm <vm> kill      stop (graceful ACPI, then SIGKILL)
  qvm -h             this help

VM root: $VM_ROOT/<vm>/<vm>.sh
EOF
  echo "Available VMs:"
  local found=0 v
  while IFS= read -r v; do
    [ -n "$v" ] || continue
    echo "  $v"; found=1
  done < <(list_vms)
  [ "$found" = 0 ] && echo "  (none — drop a <vm>.sh in $VM_ROOT/<vm>/)"
}

# ── parse args ───────────────────────────────────────────────────────
case "${1:-}" in
  -h|--help|"") usage; exit 0 ;;
esac

VM_NAME="$1"; shift
VM_DIR="$VM_ROOT/$VM_NAME"
VM_SPEC="$VM_DIR/$VM_NAME.sh"
[ -f "$VM_SPEC" ] || die "spec not found: $VM_SPEC (try: qvm -h)"
# shellcheck disable=SC1091
. "$VM_SPEC"

disk="$VM_DIR/disk.qcow2"
pidf="$VM_DIR/.pid"
spice="$VM_DIR/.spice.sock"
mon="$VM_DIR/.mon.sock"
tpm="$VM_DIR/.tpm.sock"
tpm_state="$VM_DIR/.tpm2"
ovmf_vars="$VM_DIR/.ovmf-vars.fd"

# ── config (spec may override) ───────────────────────────────────────
# These defaults are OS-agnostic. Anything OS-specific (e.g. Hyper-V
# Enlightenments in VM_CPU, TPM requirement) belongs in <vm>.sh.
VM_CORES="${VM_CORES:-auto}"
VM_MEMORY_GB="${VM_MEMORY_GB:-auto}"
VM_DISK_GB="${VM_DISK_GB:-128}"
VM_FIRMWARE="${VM_FIRMWARE:-uefi}"
VM_TPM="${VM_TPM:-0}"
VM_GPU="${VM_GPU:-virtio}"
VM_VFIO_DEVS="${VM_VFIO_DEVS:-}"
VM_DISPLAY="${VM_DISPLAY:-auto}"        # auto → spice (virtio/std) | looking-glass (vfio)
VM_IVSHMEM_SIZE="${VM_IVSHMEM_SIZE:-64}"   # MiB of Looking-Glass shared framebuffer
VM_CPU="${VM_CPU:-host}"
VM_ISO="${VM_ISO:-}"
VM_DRIVERS_ISO="${VM_DRIVERS_ISO:-}"
VM_EXTRA_ARGS="${VM_EXTRA_ARGS:-}"
VM_INSTALL_NOTE="${VM_INSTALL_NOTE:-}"

# resolve "auto" — reserve 4 threads for the host by default
case "$VM_CORES" in
  auto)
    VM_CORES=$(( $(nproc) - 4 ))
    [ "$VM_CORES" -lt 2 ] && VM_CORES=2
    ;;
esac
case "$VM_MEMORY_GB" in
  auto)
    total="$(awk '/MemTotal/{printf "%d", ($2/1024/1024)+1}' /proc/meminfo)" # ceil GiB
    VM_MEMORY_GB=$(( total - 8 )); [ "$VM_MEMORY_GB" -lt 2 ] && VM_MEMORY_GB=2
    ;;
esac
case "$VM_FIRMWARE" in
  uefi) fw=1 ;; bios) fw=0 ;;
  *) die "VM_FIRMWARE must be 'uefi' or 'bios'" ;;
esac
case "$VM_TPM" in
  1|on) tpm=1 ;; 0|off) tpm=0 ;;
  *) die "VM_TPM must be '1'|'0' (set it in $VM_SPEC)" ;;
esac

is_running() { [ -f "$pidf" ] && kill -0 "$(cat "$pidf" 2>/dev/null || true)" 2>/dev/null; }

# ── run qemu (foreground) ─────────────────────────────────────────────
run_qemu() {
  local swtpm_pid="" cleanup id
  rm -f "$spice" "$mon" "$tpm"

  local -a fw_args=()
  if [ "$fw" = 1 ]; then
    [ -f "$OVMF_CODE" ]    || { echo "qvm: OVMF_CODE not found ($OVMF_CODE) — set QVM_OVMF_CODE" >&2; return 1; }
    [ -f "$OVMF_VARS_SRC" ] || { echo "qvm: OVMF_VARS not found ($OVMF_VARS_SRC) — set QVM_OVMF_VARS" >&2; return 1; }
    [ -f "$ovmf_vars" ] || cp "$OVMF_VARS_SRC" "$ovmf_vars"
    fw_args+=( -drive "if=pflash,format=raw,readonly=on,file=$OVMF_CODE"
               -drive "if=pflash,format=raw,file=$ovmf_vars" )
  fi

  local -a tpm_args=()
  if [ "$tpm" = 1 ]; then
    mkdir -p "$tpm_state"
    swtpm socket --tpm2 --tpmstate "dir=$tpm_state" \
      --ctrl "type=unixio,path=$tpm" 2>"$tpm_state/swtpm.err" &
    swtpm_pid=$!
    local i; for ((i=0;i<30;i++)); do [ -S "$tpm" ] && break; sleep 0.1; done
    [ -S "$tpm" ] || {
      echo "qvm: swtpm failed to start (see $tpm_state/swtpm.err)" >&2
      kill "$swtpm_pid" 2>/dev/null || true; return 1; }
    tpm_args+=( -chardev "socket,id=chrtpm,path=$tpm"
               -tpmdev  "emulator,id=tpm0,chardev=chrtpm"
               -device  "tpm-crb,tpmdev=tpm0" )
  fi

  local -a gpu_args=()
  case "$VM_GPU" in
    virtio) gpu_args+=( -vga none -device virtio-gpu ) ;;
    std)    gpu_args+=( -vga std ) ;;
    vfio)   for id in $VM_VFIO_DEVS; do gpu_args+=( -device "vfio-pci,host=$id" ); done ;;
    *) echo "qvm: VM_GPU must be 'virtio' | 'std' | 'vfio'" >&2; return 1 ;;
  esac

  # display mode: 'auto' → spice (virtio/std), looking-glass (vfio).
  case "$VM_DISPLAY" in
    auto) if [ "$VM_GPU" = "vfio" ]; then VM_DISPLAY="looking-glass"; else VM_DISPLAY="spice"; fi ;;
    spice|looking-glass) ;;
    *) echo "qvm: VM_DISPLAY must be 'spice' | 'looking-glass' (got '$VM_DISPLAY')" >&2; return 1 ;;
  esac

  local -a disp_args=()
  if [ "$VM_DISPLAY" = "spice" ]; then
    disp_args=( -spice "unix=on,path=$spice,disable-ticketing=on"
                -device virtio-serial
                -chardev "spicevmc,id=vdagent,name=vdagent"
                -device  "virtserialport,chardev=vdagent,name=com.redhat.spice.0"
                -audiodev "spice,id=spice-audio"
                -device intel-hda -device "hda-duplex,audiodev=spice-audio" )
    # attach the Spice display once the socket is up
    ( sleep 1; exec remote-viewer "spice+unix://$spice" ) >/dev/null 2>&1 &
  else
    # Looking-Glass: shared-memory framebuffer between the guest (running
    # the LG host app) and looking-glass-client on this host. (Re)create
    # /dev/shm/looking-glass if missing/too small. Both qemu and lg-client
    # run as the invoking user, so 0600 suffices.
    local lgshm="/dev/shm/looking-glass"
    local need=$(( VM_IVSHMEM_SIZE * 1024 * 1024 ))
    if [ ! -f "$lgshm" ] || [ "$(stat -c %s "$lgshm" 2>/dev/null || echo 0)" -lt "$need" ]; then
      truncate -s "${VM_IVSHMEM_SIZE}M" "$lgshm"
    fi
    chmod 600 "$lgshm" 2>/dev/null || true
    disp_args=( -display none
                -object "memory-backend-file,id=lgmem,size=${VM_IVSHMEM_SIZE}M,mem-path=$lgshm,share=on"
                -device "ivshmem-plain,memdev=lgmem" )
    ( sleep 1; exec looking-glass-client ) >/dev/null 2>&1 &
    echo "qvm: VM_DISPLAY=looking-glass — ivshmem $lgshm (${VM_IVSHMEM_SIZE}M); launched looking-glass-client" >&2
  fi

  # reap swtpm + sockets when the guest powers off
  cleanup="rm -f '$spice' '$mon' '$tpm'"
  [ -n "$swtpm_pid" ] && cleanup="kill $swtpm_pid 2>/dev/null || true; $cleanup"
  trap "$cleanup" EXIT

  qemu-system-x86_64 \
    -enable-kvm -name "$VM_NAME" -pidfile "$pidf" \
    -machine "q35,accel=kvm" -cpu "$VM_CPU" -smp "$VM_CORES" -m "${VM_MEMORY_GB}G" \
    "${fw_args[@]}" \
    -drive "file=$disk,if=virtio,format=qcow2" \
    "${tpm_args[@]}" \
    "${gpu_args[@]}" \
    "${disp_args[@]}" \
    -netdev "user,id=net0" -device "virtio-net,netdev=net0" \
    -device "qemu-xhci,id=xhci" -device usb-kbd -device usb-tablet \
    -monitor "unix:$mon,server,nowait" \
    "$@"
}

attach() {
  [ -S "$spice" ] || { echo "qvm: $VM_NAME not running (no Spice socket at $spice)" >&2; return 1; }
  exec remote-viewer "spice+unix://$spice"
}

start() {
  if is_running; then attach; return; fi
  [ -f "$disk" ] || { echo "qvm: no disk — run \`qvm $VM_NAME install\` first" >&2; return 1; }
  # shellcheck disable=SC2206
  local -a extra=( $VM_EXTRA_ARGS )
  echo "qvm: starting $VM_NAME — ${VM_CORES} cores, ${VM_MEMORY_GB}G, ${VM_GPU}-gpu"
  run_qemu "${extra[@]}"
}

install() {
  [ -n "$VM_ISO" ] && [ -f "$VM_ISO" ] || {
    echo "qvm: VM_ISO not found ('$VM_ISO') — set it in $VM_SPEC" >&2; return 1; }
  if [ ! -f "$disk" ]; then
    echo "qvm: creating $disk (${VM_DISK_GB}G)…"
    qemu-img create -f qcow2 "$disk" "${VM_DISK_GB}G"
  fi
  local -a extra=( -cdrom "$VM_ISO" -boot "menu=on,strict=on,splash-time=5000" )
  if [ -n "$VM_DRIVERS_ISO" ] && [ -f "$VM_DRIVERS_ISO" ]; then
    extra+=( -drive "id=driverscd,if=none,format=raw,file=$VM_DRIVERS_ISO,readonly=on"
             -device "usb-storage,drive=driverscd,removable=on" )
  else
    echo "qvm: VM_DRIVERS_ISO not set — load any needed drivers during install" >&2
  fi
  [ -n "$VM_INSTALL_NOTE" ] && echo "qvm: $VM_INSTALL_NOTE"
  # shellcheck disable=SC2206
  extra+=( $VM_EXTRA_ARGS )
  echo "qvm: installing $VM_NAME from $VM_ISO"
  echo "qvm: at 'press any key to boot from CD' press a key on the first boot only;"
  echo "     on later reboots don't press — let it boot the disk."
  run_qemu "${extra[@]}"
}

kill_vm() {
  local p; p="$(cat "$pidf" 2>/dev/null || true)"
  if [ -n "$p" ] && kill -0 "$p" 2>/dev/null; then
    # graceful: ask the guest to power down via ACPI over the monitor socket
    if [ -S "$mon" ]; then
      ( exec 3<>"$mon"; printf 'system_powerdown\n' >&3 ) 2>/dev/null || true
      local i; for ((i=0;i<30;i++)); do kill -0 "$p" 2>/dev/null || break; sleep 0.5; done
    fi
    kill -9 "$p" 2>/dev/null || true; wait "$p" 2>/dev/null || true
  fi
  pkill -f "$tpm" 2>/dev/null || true
  rm -f "$pidf" "$mon" "$spice" "$tpm"
  echo "qvm: stopped $VM_NAME"
}

# ── CLI ───────────────────────────────────────────────────────────────
case "${1:-start}" in
  -h|--help) usage; exit 0 ;;
  install)   install ;;
  kill)      kill_vm ;;
  start|"")  start ;;
  *) echo "qvm: unknown command '$1' (try: install | kill | start)" >&2; exit 1 ;;
esac
