#!/usr/bin/env bash
# db — distrobox launcher.
#
# Each box is a directory under boxes/ with a Containerfile and an optional
# init.sh. `db <name>` auto-builds the image if missing, creates the container
# (with --nvidia + init hooks) if missing, and enters. init.sh runs on every
# enter via distrobox --init-hooks (idempotent — safe to re-run).
#
#   db               list every box (created status + active marker)
#   db <name>        build image if missing, create if missing, enter
#   db build <name>  force-rebuild the image, recreate container, enter
#   db -h            usage

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd)"
BOXES_DIR="$SCRIPT_DIR/boxes"

image_name() { echo "localhost/$1:latest"; }

# Box names from boxes/ (one dir == one box).
available_boxes() {
  local d
  for d in "$BOXES_DIR"/*/; do
    [ -d "$d" ] || continue
    basename "$d"
  done
}

# ── list ──────────────────────────────────────────────────────────────
list_boxes() {
  local -A created=()
  local name img
  while IFS=$'\t' read -r name img; do
    [ -n "$name" ] && created["$name"]="$img"
  done < <(distrobox list 2>/dev/null | jq -r '.[] | [.name, .image] | @tsv' 2>/dev/null || true)

  local active=""
  active="$(distrobox list 2>/dev/null | jq -r 'first(.[] | select(.status=="running")) | .name' 2>/dev/null || true)"

  local n mark
  for n in $(available_boxes | sort); do
    img="$(image_name "$n")"
    mark=" "; [ "$n" = "$active" ] && mark="*"
    if [ -n "${created[$n]+x}" ]; then
      printf '%-14s [created]   %s  %s\n' "$n" "$img" "$mark"
    else
      printf '%-14s [—]         %s  %s\n' "$n" "$img" "$mark"
    fi
  done
}

# ── build ─────────────────────────────────────────────────────────────
build_image() {
  local name="$1" image; image="$(image_name "$name")"
  echo "db: building '$name' → $image …"
  docker build -t "$image" "$BOXES_DIR/$name"
}

# ── enter ──────────────────────────────────────────────────────────────
enter_box() {
  local name="$1" image; image="$(image_name "$name")"

  if [ ! -d "$BOXES_DIR/$name" ]; then
    echo "db: unknown box '$name'" >&2
    echo "Available:" >&2
    available_boxes | sort | sed 's/^/  /' >&2
    return 1
  fi

  # Build the image if it doesn't exist yet.
  if ! docker image inspect "$image" >/dev/null 2>&1; then
    build_image "$name"
  fi

  # Already created? Just enter.
  if distrobox list 2>/dev/null | jq -e --arg n "$name" '.[].name == $n' >/dev/null 2>&1; then
    exec distrobox enter "$name"
  fi

  # Create with nvidia + auto-init (if init.sh exists).
  local init_sh="$BOXES_DIR/$name/init.sh"
  local -a create_args=(--name "$name" --image "$image" --nvidia)
  if [ -f "$init_sh" ]; then
    create_args+=(--volume "$init_sh:/init.sh:ro" --init-hooks "bash /init.sh")
  fi

  echo "db: creating '$name' from '$image' (nvidia)…"
  distrobox create "${create_args[@]}"
  exec distrobox enter "$name"
}

# ── CLI ────────────────────────────────────────────────────────────────
usage() {
  cat <<EOF
db — distrobox launcher

Usage:
  db               list all boxes (created status + active marker)
  db <name>        build image if missing, create if missing, enter
  db build <name>  force-rebuild the image, recreate container, enter
  db -h            this help

Boxes:  $BOXES_DIR/
EOF
  available_boxes | sort | sed 's/^/  /'
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  build)
    shift
    [ $# -ge 1 ] || { echo "db: build needs a box name" >&2; exit 1; }
    build_image "$1"
    distrobox rm -f "$1" 2>/dev/null || true
    enter_box "$1"
    ;;
  ""|list) list_boxes ;;
  *)       enter_box "$1" ;;
esac
